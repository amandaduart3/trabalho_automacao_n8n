    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-4-hydrogen:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Você é um tutor especialista em concursos públicos de TI (banca Cesgranrio). Gere 1 flashcard técnico e direto sobre a disciplina '{{ $json.disciplina }}' e o tópico '{{ $json.topico }}'. A pergunta deve exigir uma definição técnica ou diferenciação clara que possa ser escrita à mão em até 35 segundos. A resposta deve ser objetiva e precisa. Retorne APENAS um objeto JSON válido com as chaves 'pergunta' e 'resposta'.\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\",\n    \"temperature\": 0.4\n  }\n}",
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        688,
        16
      ],
      "id": "bf9db379-e0ed-4abf-959f-65469b9b255c",
      "name": "Gerar Flashcard Gemini",
      "credentials": {
        "httpHeaderAuth": {
          "id": "PlSYcLzlb0XleoGV",
          "name": "Header Auth account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json?.candidates?.[0]?.content?.parts?.[0]?.text || '';\nconst contexto = $('Configurar Contexto').first().json;\n\nlet origemChatId = null;\ntry {\n  origemChatId = $('Edit Fields1').first()?.json?.chat_id || null;\n} catch (e) {\n}\nif (origemChatId && origemChatId !== contexto.chat_id) {\n  return [{ json: { valido: false, erro: 'Comando enviado fora do chat autorizado.' } }];\n}\n\nif (!contexto.topico_id) {\n  return [{ json: { valido: false, erro: 'A tabela topicos_estudo está vazia no PostgreSQL.' } }];\n}\n\ntry {\n  const cleanJson = rawText.replace(/```json|```/g, '').trim();\n  const parsed = JSON.parse(cleanJson);\n\n  if (!parsed.pergunta || !parsed.resposta) {\n    return [{ json: { valido: false, erro: 'JSON incompleto retornado pela IA.' } }];\n  }\n\n  const textoPergunta = `🧠 *FLASHCARD DE REVISÃO*\\n` +\n    `📚 *Disciplina:* ${contexto.disciplina}\\n` +\n    `📌 *Tópico:* ${contexto.topico}\\n\\n` +\n    `❓ *Pergunta:*\\n${parsed.pergunta}\\n\\n` +\n    `⏳ _Você tem 40 segundos para anotar sua resposta no caderno..._`;\n\n  const textoResposta = `✅ *GABARITO DO FLASHCARD*\\n\\n` +\n    `💡 *Resposta esperada:*\\n${parsed.resposta}\\n\\n` +\n    `📝 _Compare com o que você escreveu no caderno!_`;\n\n  return [{\n    json: {\n      valido: true,\n      pergunta: parsed.pergunta,\n      resposta: parsed.resposta,\n      texto_pergunta: textoPergunta,\n      texto_resposta: textoResposta\n    }\n  }];\n} catch (e) {\n  return [{\n    json: {\n      valido: false,\n      erro: `Falha ao interpretar JSON: ${e.message}`\n    }\n  }];\n}"
      },
