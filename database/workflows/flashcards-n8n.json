        "query": "SELECT t.id, t.disciplina, t.topico, c.meu_chat_id, c.waha_session\nFROM config_bot c\nLEFT JOIN topicos_estudo t ON TRUE\nWHERE c.id = 1\nORDER BY t.ultima_revisao ASC NULLS FIRST, t.vezes_revisado ASC, t.id ASC\nLIMIT 1;",
